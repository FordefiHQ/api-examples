# Fordefi API user token
FORDEFI_API_USER_TOKEN=

# The Fordefi Stellar vault that will SPONSOR the reserves.
# It must be the envelope source account — Fordefi rejects stellar_raw_transaction
# with INVALID_VAULT_FIELD if the named vault isn't the source.
FORDEFI_STELLAR_VAULT_ID=
STELLAR_VAULT_ADDRESS=

# Secret seed of the account being sponsored. Generate one with `npm run gen-keypair`.
# This account does not exist on-chain yet — the run creates it with a zero balance.
# The seed stays local: it signs EndSponsoringFutureReserves after Fordefi has signed.
SPONSORED_ED25519_SECRET=

# Asset for the sponsored trustline. Example below is Circle USDC on mainnet.
STELLAR_ASSET_CODE=USDC
STELLAR_ASSET_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Optional
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/public
# Generous by default: the Fordefi sign round trip plus our own broadcast can
# easily exceed the 180s other examples use, which would mean tx_too_late.
STELLAR_TX_TIMEOUT_SECS=3600
