# Shared by every solana-kit example. Copy to .env (next to this file) and fill in what you need:
#   cp .env.example .env
# A .env inside an example's own directory, if present, overrides values set here.

# --- Required by every example ---
FORDEFI_API_TOKEN=your_api_user_access_token
FORDEFI_VAULT_ID=your_solana_vault_id              # Fordefi vault UUID
FORDEFI_VAULT_ADDRESS=your_solana_vault_address    # the vault's base58 Solana address

# --- Optional: where the API User private key lives (default: ./secret/private.pem next to this file)
# FORDEFI_PRIVATE_KEY_PATH=/absolute/path/to/private.pem

# --- spl-transfer, batch, gas-station
DESTINATION_ADDRESS=recipient_address
# --- batch
DESTINATION_ADDRESS_2=second_recipient_address

# --- gas-station: the vault that pays the network fees
FEE_PAYER_VAULT_ID=fee_payer_vault_id
FEE_PAYER_VAULT_ADDRESS=fee_payer_vault_address

# --- fixed-delegation
DELEGATOR_VAULT_ID=delegator_vault_id
DELEGATOR_VAULT_ADDRESS=delegator_vault_address
DELEGATEE_VAULT_ID=delegatee_vault_id              # only required for `npm run transfer`
DELEGATEE_VAULT_ADDRESS=delegatee_vault_address

# --- staking (ACTION can also be passed per run: ACTION=unstake npm run action)
ACTION=stake                                       # stake | unstake | withdraw
VALIDATOR_ADDRESS=validator_vote_account_address   # required for stake
STAKE_ACCOUNT_ADDRESS=your_stake_account_address   # required for unstake and withdraw

# --- orca (harvest-position, increase/remove-liquidity, close-position)
ORCA_POSITION_MINT_ADDRESS=your_position_mint_address
