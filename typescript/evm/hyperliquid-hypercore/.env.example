# Copy to .env and fill in. Never commit .env, and keep it owner-only: chmod 600 .env
#
# Add ONLY the variables below. dotenv loads every entry into process.env, where any
# dependency in the process can read it — unrelated keys for other chains or services
# do not belong in this file.

# Fordefi API credentials (required)
FORDEFI_API_USER_TOKEN=

# Fordefi EVM vault that acts as the Hyperliquid master account (required)
FORDEFI_EVM_VAULT_ID=
FORDEFI_EVM_VAULT_ADDRESS=

# Action to run (see src/config.ts). One of:
# deposit | withdraw | sendUsd | vault_transfer | approve_agent | revoke_agent | spotTransfer | subAccountTransfer | placeOrder
ACTION=subAccountTransfer

# Hyperliquid network. Defaults to true when omitted, so an unconfigured run cannot
# move real funds. Set to exactly "false" for mainnet — any other value is rejected
# rather than being treated as mainnet. The resolved network is printed at startup.
HYPERLIQUID_TESTNET=true

# Common action inputs. destination is required by withdraw and sendUsd.
DESTINATION_ADDRESS=
AMOUNT=5

# Sub-account address for the "subAccountTransfer" action — used as transfer.to in src/config.ts.
# Create the sub-account in the Hyperliquid (testnet) UI first, then paste its address here.
SUBACCOUNT_ADDRESS=
