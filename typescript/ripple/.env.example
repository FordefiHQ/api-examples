FORDEFI_API_USER_TOKEN=
FORDEFI_RIPPLE_VAULT_ID=

# ripple_mainnet | ripple_testnet (defaults to ripple_testnet)
NETWORK=ripple_testnet

# transfer:xrp — amount in DROPS (native XRP has 6 decimals, so 1000000 = 1 XRP),
# passed to the API unscaled. Recipient is a classic address.
RIPPLE_XRP_AMOUNT=1000000
RIPPLE_RECIPIENT_ADDRESS=
# Destination tag, as a numeric string. Required by most exchanges.
# RIPPLE_DESTINATION_TAG=

# transfer:token and trustline — issued token (IOU) currency + issuer
# currency: 3-char code (e.g. USDC) or 40-char hex code
RIPPLE_CURRENCY=USDC
RIPPLE_ISSUER_ADDRESS=rHuGNhqTG32mfmAvWA8hUyWRLV3tCSwKQt
# Amount in the asset's SMALLEST UNITS, passed to the API unscaled.
# XRPL trust-line assets have 15 decimals, so 1000000000000000 = 1 USDC
# and 1 = 0.000000000000001 USDC. Confirm decimals for your asset with
# GET /api/v1/vaults/{id}/assets -> asset_info.decimals
RIPPLE_TOKEN_AMOUNT=1000000000000000
# Defaults to RIPPLE_RECIPIENT_ADDRESS when unset
# RIPPLE_TOKEN_RECIPIENT_ADDRESS=

# check:cash — Fordefi transaction UUID from `npm run checks:list`.
# Leave unset to auto-select when the vault has exactly one claimable check.
# RIPPLE_CHECK_SOURCE_TX_ID=
