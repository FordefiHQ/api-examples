# Fordefi API access token. Required by webhooks_audit_logs.ts (ADMIN or VIEWER
# role, for the audit-log API) and webhooks_hypernative.ts.
FORDEFI_API_USER_TOKEN=
# Fordefi Public key for validating the auhtenticity of incoming webhooks,
# choose the appropriate key based on use-case
FORDEFI_PUBLIC_KEY_PATH=./keys/fordefi_public_key.pem
