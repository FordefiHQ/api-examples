# Access token of the Fordefi API user acting as the API Approver.
# The API user needs the Trader role and must be included as an approver in the policy
# rule's approval quorum. It should never initiate transactions itself.
FORDEFI_API_USER_TOKEN=your_fordefi_api_user_access_token

# Address of the Fordefi vault whose transactions this API Approver validates.
ORIGIN_VAULT=0xYourFordefiVaultAddress

# Fordefi's webhook signing public key (defaults to the one committed in this repo).
FORDEFI_PUBLIC_KEY_PATH=./public_key.pem

# Trust the X-Forwarded-For header when resolving the caller's IP. Defaults to false,
# which uses the socket peer address so the header cannot be spoofed. Enable it ONLY
# when this service sits behind a proxy that overwrites the header (ngrok, your own
# load balancer) — ngrok-based testing needs it on, since the peer IP is 127.0.0.1.
TRUST_PROXY_HEADER=false

# Log verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Directory for the persisted audit log (rotated daily). Defaults to ./live-logs.
LOG_DIR=./live-logs

# How many days of rotated audit logs to retain. Defaults to 90.
LOG_RETENTION_DAYS=90
